{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "strava-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "TOKENS", "class_name": "TokenStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TokenStore"] }]
}
